{
  "status": "Recommended declarations, not measurements of rendered UI",
  "shell": {
    "sidebar_width": 168,
    "header_height": 40,
    "workspace_padding_per_side": 16,
    "region_seam": 1,
    "inspector_width": 288,
    "inspector_collapses_at_or_below": 1024,
    "sidebar_collapses_at_or_below": 768
  },
  "typography": {
    "body_size": 14,
    "body_line_height": 21,
    "metadata_size": 13,
    "metadata_line_height": 18,
    "chrome_max_heading_size": 16,
    "family": "system sans; monospace for code/identifiers"
  },
  "density": {
    "navigation_row_height": 32,
    "data_row_height": 40,
    "control_height": 28,
    "touch_control_height": 36,
    "control_radius": 6,
    "panel_radius": 10,
    "spacing_unit": 4
  },
  "views": {
    "Conversation": {
      "desktop_secondary": 288,
      "secondary_role": "Optional selected-worker inspector",
      "content": "One main-agent conversation; model and effort controls beside composer; no parallel chat inboxes."
    },
    "Runs": {
      "desktop_secondary": 0,
      "secondary_role": "Run selection opens RunDetail",
      "content": "Rows for task, outcome, provider/model, updated time, and next action; filters above the rows."
    },
    "RunDetail": {
      "desktop_secondary": 288,
      "secondary_role": "Optional run metadata/configuration inspector",
      "content": "Selected run timeline with Activity, Changes, and Artifacts tabs; resume/stop state is explicit."
    },
    "Progress": {
      "desktop_secondary": 288,
      "secondary_role": "Optional selected-task inspector",
      "content": "Graph, board, and radar project the same tasks/runs. Board pans on desktop; mobile selects one lane."
    },
    "Reviews": {
      "desktop_secondary": 224,
      "secondary_role": "Review queue",
      "content": "Queue selection and review evidence; preview/diff split on wide screens, tabs on narrow screens."
    },
    "Files": {
      "desktop_secondary": 224,
      "secondary_role": "File tree",
      "content": "Repository files and .factory settings files. Editor keeps a deliberately scrollable code region."
    },
    "Settings": {
      "desktop_secondary": 160,
      "secondary_role": "Settings section navigation",
      "content": "Factory goal, provider/model defaults, reasoning/agency, integrations, and file-backed configuration."
    }
  },
