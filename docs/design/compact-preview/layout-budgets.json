  "responsive_rules": [
    "At <=1024px, close the inspector and secondary file/review/settings navigation; use a drawer or route that preserves selection.",
    "At <=768px, collapse the global sidebar to a labelled navigation drawer. Preserve page scope and back navigation.",
    "At 390px, use one 320px-minimum work surface inside 16px padding; run metadata stacks and settings labels appear above controls.",
    "At <=1024px, review preview and diff are tabs. Do not squeeze them into side-by-side slivers.",
    "At 768px, hide updated-time column from Runs and preserve it in RunDetail; at 390px render runs as stacked rows.",
    "Progress graph/radar use the available main width; pan a graph intentionally instead of shrinking node text. Desktop board has deliberate horizontal scrolling; mobile selects one lane.",
    "Model and reasoning controls wrap within the composer at narrow widths; never reduce body or metadata size to fit.",
    "Header truncates only the long task name; state/action remain visible and full name is available by focus or selection."
  ],
  "limits": [
    "Checker measures declared horizontal arithmetic and opaque color pairs only.",
    "Header height, target dimensions, vertical composition, line wrapping, zoom/reflow, focus, keyboard behavior, and actual computed styles need rendered checks.",
    "Decorative separators/rings may use subtle tokens; meaningful control boundaries, state graphics and graph edges use boundary/status tokens.",
    "No connection, task completion, model availability or configuration persistence is proven by these declarations."
  ]
}
